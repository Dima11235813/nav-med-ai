{
  "name": "nav-med-ai",
  "version": "1.0.0",
  "description": "Nav Med AI - Healthcare Navigation Platform",
  "private": true,
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:full": "node scripts/start-dev.js",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:data": "echo 'Data pipeline service not yet implemented'",
    "start": "npm run dev:full",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "install:all": "npm install",
    "install:web": "cd apps/web && npm install",
    "install:api": "cd apps/api && npm install",
    "setup": "npm run install:all && npm run build:packages",
    "build:packages": "cd packages/types && npm run build && cd ../config && npm run build && cd ../ui && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dima11235813/nav-med-ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Dima11235813/nav-med-ai/issues"
  },
  "homepage": "https://github.com/Dima11235813/nav-med-ai#readme",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nx": "^21.5.1",
    "turbo": "^2.5.6"
  }
}
