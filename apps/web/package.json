{
  "name": "nav-med-ai-web",
  "version": "0.0.1",
  "description": "Nav Med AI - Healthcare Navigation Platform Web Application",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
